APP_NAME="PetroWeb Frota"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=America/Sao_Paulo
APP_URL=http://localhost:8000

APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=pt_BR

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

# ── Banco do tenant (conexão padrão) ────────────────────────────────────────
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=frota_dev
DB_USERNAME=postgres
DB_PASSWORD=

# ── Banco CENTRAL do provedor (tenants, domains, licenças) ──────────────────
# Host e credenciais caem para DB_* quando não definidos; só o nome muda.
CENTRAL_DB_DATABASE=frota_central

# Painel do provedor — domínio próprio, login próprio, banco central.
PROVEDOR_DOMAIN=admin.frota.petroweb.app

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_FROM_ADDRESS="nao-responda@frota.petroweb.app"
MAIL_FROM_NAME="${APP_NAME}"

# ── Fiscal ──────────────────────────────────────────────────────────────────
# Provedor da comunicação com a SEFAZ. A aplicação fala com a
# SefazGatewayInterface, nunca com o fornecedor direto — trocar de provedor
# é trocar uma implementação. Ver documento 03, seção 2.
SEFAZ_GATEWAY=fake
SEFAZ_API_URL=
SEFAZ_API_TOKEN=

# Retenção de XML em meses. Padrão 132 (11 anos, Ajuste SINIEF 2/2025).
FISCAL_RETENCAO_MESES=132

# ── Vale-pedágio ────────────────────────────────────────────────────────────
# Lista de CNPJ de fornecedoras habilitadas, sincronizada do portal SVRS.
VPO_SYNC_URL=
