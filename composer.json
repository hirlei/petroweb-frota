{
    "name": "halc/petroweb-frota",
    "type": "project",
    "description": "PetroWeb Frota — gestão de transporte rodoviário de cargas (TMS) com CT-e e MDF-e.",
    "keywords": ["tms", "transportadora", "cte", "mdfe", "frota", "laravel"],
    "license": "proprietary",
    "require": {
        "php": "^8.2",
        "bacon/bacon-qr-code": "^3.1",
        "barryvdh/laravel-dompdf": "^3.1",
        "laravel/breeze": "^2.4",
        "laravel/framework": "^11.0",
        "laravel/sanctum": "^4.3",
        "laravel/tinker": "^2.9",
        "livewire/livewire": "^4.3",
        "phpoffice/phpspreadsheet": "*",
        "pragmarx/google2fa-laravel": "^3.0",
        "spatie/laravel-activitylog": "*",
        "spatie/laravel-permission": "^6.25",
        "stancl/tenancy": "*"
    },
    "require-dev": {
        "fakerphp/faker": "^1.23",
        "laravel/pint": "^1.13",
        "larastan/larastan": "^3.0",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.0",
        "phpunit/phpunit": "^11.0",
        "spatie/laravel-ignition": "^2.4"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "lint": "pint --test",
        "analyse": "phpstan analyse --memory-limit=1G",
        "test": "@php artisan test"
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
